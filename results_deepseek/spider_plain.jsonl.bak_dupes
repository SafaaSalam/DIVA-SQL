{"id": "spider_dev_167", "db_id": "car_1", "question": "Among the cars with more than lowest horsepower, which ones do not have more than 3 cylinders? List the car makeid and make name.", "gold_sql": "SELECT T2.MakeId ,  T2.Make FROM CARS_DATA AS T1 JOIN CAR_NAMES AS T2 ON T1.Id  =  T2.MakeId WHERE T1.Horsepower  >  (SELECT min(Horsepower) FROM CARS_DATA) AND T1.Cylinders  <=  3;", "category": "nested", "difficulty": null, "pred_sql": "SELECT car_names.MakeId, car_names.Make\nFROM car_names\nJOIN cars_data ON car_names.MakeId = cars_data.Id\nWHERE cars_data.Horsepower > (SELECT MIN(Horsepower) FROM cars_data)\n  AND cars_data.Cylinders <= 3", "status": "SUCCESS", "pred_executes": true, "pred_exec_error": null, "gold_executes": true, "ex": true, "latency_s": 3.365, "llm_calls": 1, "prompt_tokens": 179, "output_tokens": 609}
